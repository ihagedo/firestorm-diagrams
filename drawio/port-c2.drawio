        <mxCell id="v-l2_core_lru" value="&lt;b&gt;Replacement&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;LRU among one core&amp;#x27;s lines&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;not LRU across cores&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;per core stacks, round robin victim&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#feebde;strokeColor=#fb9d5c;strokeWidth=1;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="530" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="v-l2_autolock" value="&lt;b&gt;AutoLock&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;spares lines an L1D still holds&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;threshold ~3 of 8 (S2C test)&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;L1 copy bits from duplicate L1 tags&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#feebde;strokeColor=#fb9d5c;strokeWidth=1;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="380" y="530" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="v-l2_hashed_way_filter" value="&lt;b&gt;Lookup order&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;partial tag compare picks ways&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;sense amps of those ways only&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;then the full 20 b compare&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;no way predictor table&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9f6;strokeColor=#fb9d5c;strokeWidth=1;dashed=1;dashPattern=4 3;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="700" y="530" width="300" height="108.25" as="geometry" />
        </mxCell>
        <mxCell id="v-l2_zero_line_tags" value="&lt;b&gt;Zero tag&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;all zero line kept as a tag bit&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;no data array write&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;unmeasured&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9f6;strokeColor=#fb9d5c;strokeWidth=1;dashed=1;dashPattern=4 3;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="1020" y="530" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="v-opt1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#feebde;strokeColor=#fb9d5c;strokeWidth=1;dashed=0;fontSize=10;fontColor=#1f2937;align=center;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
