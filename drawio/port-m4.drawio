        <mxCell id="subtitle" value="A matrix scheduler fits what is measured, operands read at issue and queues that do not shift. The entry format and the replay rule are proposed." style="text;html=1;kind=title;fontSize=11;fontColor=#4b5563;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
