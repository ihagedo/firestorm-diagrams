          <mxGeometry x="50" y="80" width="1000" height="560" as="geometry" />
        </mxCell>
        <mxCell id="f-pcl-note" value="3.2 GHz, one clock domain" style="text;html=1;fontSize=10;fontColor=#4b5563;align=right;verticalAlign=middle;spacing=0;spacingRight=3;connectable=0;" vertex="1" parent="1">
