  <diagram id="d1" name="Apple M1, the die as a block diagram">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1230" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Apple M1, the die as a block diagram" style="text;html=1;kind=title;fontSize=18;fontStyle=1;fontColor=#1f2937;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="17" y="11" width="515" height="26" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Two CPU clusters share one memory side through the fabric. Arrow weight is traffic; dashed is control. Bandwidths are what one core measures." style="text;html=1;kind=title;fontSize=11;fontColor=#4b5563;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="17" y="37" width="1159" height="18" as="geometry" />
        </mxCell>
