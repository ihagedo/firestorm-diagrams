        <mxCell id="n-one_entry_illustrative_valid_i" value="one entry, illustrative: valid is one bit per 16 B" style="text;html=1;fontSize=9;fontColor=#4b5563;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="660.0" y="98.5" width="298.2" height="16.5" as="geometry" />
        </mxCell>
        <mxCell id="n-miss" value="miss" style="text;html=1;fontSize=9;fontColor=#1f2937;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;rounded=1;owner=e-l1d-fill_buffer_pool;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="270.0" y="143.5" width="40.0" height="18.5" as="geometry" />
