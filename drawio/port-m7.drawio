        <mxCell id="v-l2_index" value="&lt;b&gt;Physical index, partly hashed&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;set bits span offset and frame&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;two bits XOR higher frame bits&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;some strides crowd part of the cache&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#feebde;strokeColor=#fb9d5c;strokeWidth=1;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="790" width="540" height="120" as="geometry" />
        </mxCell>
        <mxCell id="v-l2_halves" value="&lt;b&gt;Two 64 B halves per line&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;fill and evict on their own&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;one half or both to the L1, disputed&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;order kept per 128 B line, patent&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fedcc5;strokeColor=#f97316;strokeWidth=1.4;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="620" y="790" width="540" height="120" as="geometry" />
        </mxCell>
        <mxCell id="v-l2_replace" value="&lt;b&gt;Replacement spares L1 lines&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;LRU among one core&amp;#x27;s lines&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;not LRU across cores&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;inclusive; AutoLock measured&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fedcc5;strokeColor=#f97316;strokeWidth=1.4;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="930" width="540" height="110" as="geometry" />
        </mxCell>
        <mxCell id="v-l2_hashed_way_filter" value="&lt;b&gt;Partial tag way filter&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;limits which ways are read&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9f6;strokeColor=#fb9d5c;strokeWidth=1;dashed=1;dashPattern=4 3;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="620" y="930" width="540" height="110" as="geometry" />
        </mxCell>
        <mxCell id="v-l2_cachelets" value="&lt;b&gt;Four 3 MiB cachelets&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;one beside each core, likely&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;17 cycles to 3 MiB, more beyond&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;about 7.5 MiB seen by one core&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9f6;strokeColor=#fb9d5c;strokeWidth=1;dashed=1;dashPattern=4 3;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="1200" y="710" width="560" height="150" as="geometry" />
        </mxCell>
        <mxCell id="v-cachelet_pick" value="&lt;b&gt;Our proposal for the pick&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;the two hashed bits choose the cachelet&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;a far placement pays the fabric hop&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;that hop is the step at 3 MiB&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6e1f9;strokeColor=#c026d3;strokeWidth=1.5;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="1780" y="710" width="560" height="150" as="geometry" />
        </mxCell>
        <mxCell id="v-l2_arb" value="&lt;b&gt;Arbitration, KB conjecture&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;per core request queues&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;round robin into each bank&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;demand before prefetch&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b258c5;strokeWidth=1.3;dashed=1;dashPattern=1 2.5;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="1200" y="890" width="560" height="150" as="geometry" />
        </mxCell>
        <mxCell id="v-arb_test" value="&lt;b&gt;The test&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;three cores stream through the L2&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;a fourth pointer chases&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;its latency stays flat under round robin&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6e1f9;strokeColor=#c026d3;strokeWidth=1.5;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="1780" y="890" width="560" height="150" as="geometry" />
        </mxCell>
