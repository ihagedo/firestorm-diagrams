        <mxCell id="v-access_map-cell-16" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdf7e6;strokeColor=#dcc67c;strokeWidth=0.6;fontSize=8;fontColor=#1f2937;connectable=0;" vertex="1" parent="v-access_map">
          <mxGeometry x="521.5" y="4.0" width="33.0" height="38.0" as="geometry" />
        </mxCell>
        <mxCell id="v-ampm_prefetcher" value="&lt;b&gt;Access map prefetcher&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;a stride 2 pattern is matched and extended&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;granularity grows 64 to 128 to 256 B&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;16 stride streams at once&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;large stride and SMS side tables&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefcf5;strokeColor=#f0ca52;strokeWidth=1;dashed=1;dashPattern=4 3;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="1220" width="560" height="170" as="geometry" />
        </mxCell>
        <mxCell id="v-temporal_prefetch" value="&lt;b&gt;Temporal history&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;a GHB of just under 256 entries&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;covers random access in 15 KiB, not 16&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefcf5;strokeColor=#f0ca52;strokeWidth=1;dashed=1;dashPattern=4 3;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="1420" width="560" height="110" as="geometry" />
        </mxCell>
        <mxCell id="v-temporal_guess" value="&lt;b&gt;Our reading of the 15 KiB&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;240 lines, the buffer less the probe loop&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6e1f9;strokeColor=#c026d3;strokeWidth=1.5;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="1550" width="560" height="70" as="geometry" />
        </mxCell>
        <mxCell id="v-content_directed_prefetch" value="&lt;b&gt;Pointer chasing rule, measured&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;scans filled lines for 8 B pointer like values&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;arms after 3 accesses, stride up to 8 KiB&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;one level, into the L2 not the L1&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;a 128 entry history filter stops repeats&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;off only by a privileged HID11 bit&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcf4dc;strokeColor=#f0ca52;strokeWidth=1;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="660" y="1140" width="820" height="190" as="geometry" />
        </mxCell>
        <mxCell id="v-prefetch_throttle" value="&lt;b&gt;Throttle, patent&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;rated every 32 cycles by the L2&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;credits cap a region near 4 in flight&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;bolder when misses return late&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b258c5;strokeWidth=1.3;dashed=1;dashPattern=1 2.5;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="660" y="1360" width="400" height="150" as="geometry" />
        </mxCell>
        <mxCell id="v-pf_deny" value="&lt;b&gt;Deny list and non temporal&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;lines evicted unused are denied, patent&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;non temporal loads skip the L1 fill&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;streaming stores turn non temporal&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefcf5;strokeColor=#f0ca52;strokeWidth=1;dashed=1;dashPattern=4 3;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="1080" y="1360" width="400" height="150" as="geometry" />
        </mxCell>
        <mxCell id="v-pf_levels" value="&lt;b&gt;Which level each fills&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;stride and region into the L1D&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;DMP and temporal into the L2 only&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefcf5;strokeColor=#f0ca52;strokeWidth=1;dashed=1;dashPattern=4 3;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="660" y="1540" width="820" height="80" as="geometry" />
        </mxCell>
        <mxCell id="v-fb_test" value="&lt;b&gt;Our test for the shared pool&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;a stride stream keeping 16 lines in flight&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;plus a pointer chase: if it slows, one pool&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6e1f9;strokeColor=#c026d3;strokeWidth=1.5;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="1520" y="1140" width="820" height="110" as="geometry" />
        </mxCell>
        <mxCell id="v-dram_little" value="&lt;b&gt;Little&amp;#x27;s law beyond the L2&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;64 GB/s at 97 ns is about 48 lines of 128 B&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;the L2 miss queue depth to look for&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf9eb;strokeColor=#f0ca52;strokeWidth=1;dashed=1;dashPattern=9 3;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="1520" y="1280" width="820" height="110" as="geometry" />
        </mxCell>
        <mxCell id="v-slc_victims" value="&lt;b&gt;Where fills and victims go&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;DRAM fills enter the L2 and the L1&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;the SLC takes only L2 victims&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faecc1;strokeColor=#eab308;strokeWidth=1.4;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="1520" y="1420" width="820" height="90" as="geometry" />
        </mxCell>
        <mxCell id="v-sweep" value="&lt;b&gt;Our consequence&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;one core sweeps about 20 MiB on chip&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;past that both thrash together&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6e1f9;strokeColor=#c026d3;strokeWidth=1.5;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="1520" y="1540" width="820" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e-l1d-fill_buffer_pool" style="edgeStyle=none;noEdgeStyle=1;rounded=0;html=1;strokeWidth=1.2;strokeColor=#1f2937;dashed=1;dashPattern=2 3;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=1.00000;exitY=0.50000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.00000;entryY=0.18333;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="v-l1d" target="v-fill_buffer_pool">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-fill_buffer_pool-fill_forwarding" style="edgeStyle=none;noEdgeStyle=1;rounded=0;html=1;strokeWidth=2.8;strokeColor=#1f2937;dashed=0;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=0.50000;exitY=1.00000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.82000;entryY=0.00000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="v-fill_buffer_pool" target="v-fill_forwarding">
