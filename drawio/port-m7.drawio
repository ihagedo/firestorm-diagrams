        <mxCell id="n-wake_2_32_B" value="wake, 2 × 32 B" style="text;html=1;fontSize=9;fontColor=#1f2937;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;rounded=1;owner=e-fill_buffer_pool-fill_forwarding;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="480.0" y="421.5" width="107.1" height="18.5" as="geometry" />
