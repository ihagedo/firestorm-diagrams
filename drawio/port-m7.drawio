        <mxCell id="title" value="A miss through the fill buffers, the L2 and the prefetchers" style="text;html=1;kind=title;fontSize=18;fontStyle=1;fontColor=#1f2937;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
