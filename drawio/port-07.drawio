  <diagram id="07-beyond" name="07-beyond">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1170" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Beyond the core, the cache hierarchy and memory" style="text;html=1;kind=title;fontSize=18;fontStyle=1;fontColor=#1f2937;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="17" y="11" width="692" height="26" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="The P-cluster shares an L2 and an AMX unit. The SLC sits on the memory side of coherence and fills from L2 victims. Latencies are what one core measures." style="text;html=1;kind=title;fontSize=11;fontColor=#4b5563;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="17" y="37" width="1274" height="18" as="geometry" />
        </mxCell>
        <mxCell id="f-pcl" value="P-cluster" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbfbfc;strokeColor=#bec4cc;fontColor=#9ca3af;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;container=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="1180" height="520" as="geometry" />
        </mxCell>
        <mxCell id="f-pcl-note" value="4 Firestorm cores, 3.2 GHz max, one clock domain" style="text;html=1;fontSize=10;fontColor=#4b5563;align=right;verticalAlign=middle;spacing=0;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="840.1" y="86" width="372.9" height="14" as="geometry" />
        </mxCell>
        <mxCell id="f-others" value="Other clusters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbfbfc;strokeColor=#bec4cc;fontColor=#9ca3af;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;container=0;" vertex="1" parent="1">
