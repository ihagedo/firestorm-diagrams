        <mxCell id="f-others-note" value="share the fabric and the memory side" style="text;html=1;fontSize=10;fontColor=#4b5563;align=right;verticalAlign=middle;spacing=0;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1681.2" y="86" width="271.8" height="14" as="geometry" />
        </mxCell>
        <mxCell id="f-uncore" value="Chip" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef6f6;strokeColor=#d5989c;fontColor=#dc2626;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;container=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="670" width="1920" height="250" as="geometry" />
