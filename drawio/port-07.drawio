        <mxCell id="f-uncore-note" value="uncore" style="text;html=1;fontSize=10;fontColor=#4b5563;align=right;verticalAlign=middle;spacing=0;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1899.9" y="676" width="53.1" height="14" as="geometry" />
