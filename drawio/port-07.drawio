        <mxCell id="f-ladder" value="Latency ladder from one core" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef6f6;strokeColor=#d5989c;fontColor=#dc2626;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;container=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="950" width="1180" height="140" as="geometry" />
        </mxCell>
        <mxCell id="f-ladder-note" value="cycles at 3.2 GHz" style="text;html=1;fontSize=10;fontColor=#4b5563;align=right;verticalAlign=middle;spacing=0;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1078.8" y="956" width="134.2" height="14" as="geometry" />
        </mxCell>
        <mxCell id="v-core0" value="&lt;b&gt;Core 0&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;L1I 192 KiB&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;L1D 128 KiB&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;L1 TLBs&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbdee2;strokeColor=#9ca3af;strokeWidth=2.2;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="v-core1" value="&lt;b&gt;Core 1&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;L1I 192 KiB&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;L1D 128 KiB&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;L1 TLBs&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbdee2;strokeColor=#9ca3af;strokeWidth=2.2;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="275" y="120" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="v-core2" value="&lt;b&gt;Core 2&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;L1I 192 KiB&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;L1D 128 KiB&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;L1 TLBs&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbdee2;strokeColor=#9ca3af;strokeWidth=2.2;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="490" y="120" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="v-core3" value="&lt;b&gt;Core 3&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;L1I 192 KiB&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;L1D 128 KiB&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;L1 TLBs&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbdee2;strokeColor=#9ca3af;strokeWidth=2.2;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="705" y="120" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="v-l2" value="&lt;b&gt;Shared L2&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;12 MiB, 12 ways, 128 B lines in two halves&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;8192 sets, physical index, two bits hashed&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;17 clk hit; 85 GB/s load, 100 GB/s store per core&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;inclusive of the L1Ds; spares L1 resident lines&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;four 3 MiB cachelets; a core sees 7.5 MiB&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;per core LRU; three separately powered way groups&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdcdab;strokeColor=#f97316;strokeWidth=2.2;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="290" width="840" height="220" as="geometry" />
        </mxCell>
        <mxCell id="v-amx" value="&lt;b&gt;AMX&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;one unit per cluster&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;4 register sets, one per core&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;8 × 8 FMA grid&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;2 instr per clk in, via the SQ&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;FMA 4 clk, 30 op window&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcf0ea;strokeColor=#50b696;strokeWidth=1;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="940" y="290" width="260" height="220" as="geometry" />
        </mxCell>
        <mxCell id="v-ecl" value="&lt;b&gt;E-cluster, Icestorm&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;4 cores, own L2, own clock domain&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;own AMX unit&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f2f4;strokeColor=#babfc7;strokeWidth=1;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="1280" y="120" width="660" height="100" as="geometry" />
        </mxCell>
        <mxCell id="v-gpu" value="&lt;b&gt;GPU, 8 cores&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;shares the SLC and DRAM&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fae1e1;strokeColor=#e66767;strokeWidth=1;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="1280" y="250" width="660" height="80" as="geometry" />
        </mxCell>
        <mxCell id="v-pwr" value="&lt;b&gt;Clocks and power&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;per cluster DVFS; ramp from idle 40 to 100 ms&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;core power up about 10 µs&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;closed loop performance controller&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;power estimator throttles vector and AMX issue&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f2f4;strokeColor=#babfc7;strokeWidth=1;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="1280" y="360" width="660" height="150" as="geometry" />
        </mxCell>
        <mxCell id="v-fab" value="&lt;b&gt;Fabric and coherence&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;MOESI&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;coherence point with duplicate L2 tags, before the SLC&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;one NoC port per cluster&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;5 QoS classes, 6 virtual channels, credits&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;separate PIO network for device traffic&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef6f6;strokeColor=#e66767;strokeWidth=1;dashed=1;dashPattern=4 3;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="720" width="560" height="170" as="geometry" />
        </mxCell>
        <mxCell id="v-slc" value="&lt;b&gt;System level cache&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;8 MiB, 16 ways, 4096 sets, 128 B lines&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;memory side, exclusive of the CPU caches&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;filled by L2 victims only&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;hashed set index from PA bit 7 up&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;about 90 clk; replacement pseudo random, disputed&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fedcc5;strokeColor=#f97316;strokeWidth=1.4;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="690" y="720" width="580" height="170" as="geometry" />
        </mxCell>
        <mxCell id="v-mc" value="&lt;b&gt;Memory controllers and LPDDR4X&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;8 channels&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;91 ns loaded latency&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;68 GB/s peak, 64 GB/s from one core&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;one core saturates DRAM&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;reads and writes share one path&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;DRAM clock scales with demand&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fae1e1;strokeColor=#e66767;strokeWidth=1;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="1340" y="720" width="600" height="170" as="geometry" />
        </mxCell>
