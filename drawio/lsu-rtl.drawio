        <mxCell id="f-fs-note" value="&lt;span style=&quot;background-color:#f7e4a6;border:1.4px solid #eab308;border-radius:3px;padding:0 3px;font-weight:bold;color:#1f2937&quot;&gt;128 KiB&lt;/span&gt;, &lt;span style=&quot;background-color:#f7e4a6;border:1.4px solid #eab308;border-radius:3px;padding:0 3px;font-weight:bold;color:#1f2937&quot;&gt;8 ways&lt;/span&gt;, &lt;span style=&quot;background-color:#f7e4a6;border:1.4px solid #eab308;border-radius:3px;padding:0 3px;font-weight:bold;color:#1f2937&quot;&gt;64 B lines&lt;/span&gt;, 256 sets" style="text;html=1;fontSize=10;fontColor=#4b5563;align=right;verticalAlign=middle;spacing=0;spacingRight=3;connectable=0;" vertex="1" parent="1">
