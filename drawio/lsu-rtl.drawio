        <mxCell id="subtitle" value="A template where a micro-op lights each stage it passes. Two pipes load, one stores and one does either. A zero-cycle load never enters one." style="text;html=1;kind=title;fontSize=11;fontColor=#4b5563;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
