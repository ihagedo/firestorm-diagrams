        <mxCell id="title" value="S19 The L1 data cache, set by set and bank by bank" style="text;html=1;kind=title;fontSize=18;fontStyle=1;fontColor=#1f2937;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="17" y="11" width="716" height="26" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="A template where the player marks the set, way and bank a line uses. The micro tag picks the way, and a tree PLRU picks the victim." style="text;html=1;kind=title;fontSize=11;fontColor=#4b5563;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="17" y="37" width="1075" height="18" as="geometry" />
