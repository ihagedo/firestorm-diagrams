        <mxCell id="n-_One_buffer_holds_each_64_B_lin" value="? One buffer holds each 64 B line in flight." style="text;html=1;fontSize=9;fontColor=#4b5563;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="70.0" y="472.5" width="273.8" height="16.5" as="geometry" />
        </mxCell>
        <mxCell id="n-_A_second_miss_to_the_line_join" value="? A second miss to the line joins its waiters." style="text;html=1;fontSize=9;fontColor=#4b5563;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="70.0" y="490.0" width="292.3" height="16.5" as="geometry" />
        </mxCell>
        <mxCell id="n-_Little_s_law_gives_at_least_se" value="◇ Little's law gives at least seven, but the count is open." style="text;html=1;fontSize=9;fontColor=#4b5563;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="70.0" y="507.5" width="370.7" height="16.5" as="geometry" />
        </mxCell>
        <mxCell id="n-_Demand_loads_and_L1_prefetches" value="? Demand loads and L1 prefetches share them." style="text;html=1;fontSize=9;fontColor=#4b5563;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="70.0" y="525.0" width="300.7" height="16.5" as="geometry" />
        </mxCell>
        <mxCell id="n-A_load_that_missed_waits_in_its" value="A load that missed waits in its queue entry with the buffer number." style="text;html=1;fontSize=9;fontColor=#4b5563;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="60.0" y="616.5" width="433.3" height="16.5" as="geometry" />
        </mxCell>
        <mxCell id="n-A_prefetch_that_missed_waits_the" value="A prefetch that missed waits the same way, without a waiter." style="text;html=1;fontSize=9;fontColor=#4b5563;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="60.0" y="634.0" width="402.1" height="16.5" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
