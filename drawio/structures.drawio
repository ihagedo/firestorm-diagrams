          <mxGeometry x="869.0" y="860.5" width="94.0" height="52.0" as="geometry" />
        </mxCell>
        <mxCell id="n-Each_queue_holds_derived_backen" value="Each queue holds &lt;span style=&quot;background-color:#ebf7f3;border:1px dashed #50b696;border-radius:3px;padding:0 3px;font-weight:bold;color:#1f2937&quot;&gt;13 entries&lt;/span&gt;." style="text;html=1;fontSize=9;fontColor=#4b5563;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="70.0" y="934.0" width="192.2" height="16.5" as="geometry" />
        </mxCell>
        <mxCell id="n-Probes_see_a_pair_of_queues_as_o" value="Probes see a pair of queues as one and count double." style="text;html=1;fontSize=9;fontColor=#4b5563;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="70.0" y="951.5" width="343.7" height="16.5" as="geometry" />
        </mxCell>
        <mxCell id="n-One_source_counts_single_backen" value="One source counts &lt;span style=&quot;background-color:#dcf0ea;border:1px solid #50b696;border-radius:3px;padding:0 3px;font-weight:bold;color:#1f2937&quot;&gt;24 entries&lt;/span&gt; for a queue instead." style="text;html=1;fontSize=9;fontColor=#4b5563;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="70.0" y="969.0" width="316.9" height="16.5" as="geometry" />
        </mxCell>
        <mxCell id="n-The_six_queues_hold_single_back" value="The six queues hold &lt;span style=&quot;background-color:#dcf0ea;border:1px solid #50b696;border-radius:3px;padding:0 3px;font-weight:bold;color:#1f2937&quot;&gt;134 entries&lt;/span&gt; in all, measured directly." style="text;html=1;fontSize=9;fontColor=#4b5563;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="70.0" y="986.5" width="357.1" height="16.5" as="geometry" />
        </mxCell>
        <mxCell id="n-Empty_rows_mean_nothing_else_is" value="Empty rows mean nothing else is in flight." style="text;html=1;fontSize=9;fontColor=#4b5563;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="70.0" y="1004.0" width="276.0" height="16.5" as="geometry" />
        </mxCell>
        <mxCell id="n-wakeup" value="wakeup" style="text;html=1;fontSize=9;fontColor=#1f2937;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;rounded=1;owner=e-tags-q;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1136.0" y="146.5" width="58.3" height="18.5" as="geometry" />
        </mxCell>
        <mxCell id="n-How_select_finds_the_oldest_read" value="How select finds the oldest ready entry:" style="text;html=1;fontSize=9;fontColor=#1f2937;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1580.0" y="266.5" width="229.8" height="35.0" as="geometry" />
        </mxCell>
        <mxCell id="n-1._A_set_cell_in_row_i_column_j" value="1. A set cell in row i, column j means entry i is older than entry j." style="text;html=1;fontSize=9;fontColor=#4b5563;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1580.0" y="307.5" width="242.6" height="35.0" as="geometry" />
        </mxCell>
        <mxCell id="n-2._A_new_entry_sets_its_column_i" value="2. A new entry sets its column in every waiting entry's row." style="text;html=1;fontSize=9;fontColor=#4b5563;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1580.0" y="348.5" width="255.2" height="35.0" as="geometry" />
        </mxCell>
        <mxCell id="n-3._The_oldest_ready_entry_has_a" value="3. The oldest ready entry has a clear column in every ready row." style="text;html=1;fontSize=9;fontColor=#4b5563;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1580.0" y="389.5" width="236.7" height="35.0" as="geometry" />
        </mxCell>
        <mxCell id="n-4._An_entry_that_issues_clears_i" value="4. An entry that issues clears its row." style="text;html=1;fontSize=9;fontColor=#4b5563;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1580.0" y="430.5" width="244.3" height="18.5" as="geometry" />
        </mxCell>
        <mxCell id="n-_Apple_s_patent_and_Handley_des" value="~ Apple's patent and Handley describe it this way." style="text;html=1;fontSize=9;fontColor=#4b5563;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1580.0" y="455.0" width="260.9" height="35.0" as="geometry" />
        </mxCell>
        <mxCell id="n-ready_bits" value="ready bits" style="text;html=1;fontSize=9;fontColor=#1f2937;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;rounded=1;owner=e-q-select;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1136.0" y="698.5" width="71.5" height="18.5" as="geometry" />
        </mxCell>
        <mxCell id="n-oldest" value="oldest" style="text;html=1;fontSize=9;fontColor=#1f2937;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;rounded=1;owner=e-age_matrix-select;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1420.0" y="605.5" width="47.3" height="18.5" as="geometry" />
        </mxCell>
        <mxCell id="n-issue" value="issue" style="text;html=1;fontSize=9;fontColor=#1f2937;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;rounded=1;owner=e-select-unit;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1555.0" y="815.5" width="42.8" height="18.5" as="geometry" />
        </mxCell>
        <mxCell id="n-to_the_register_file_and_the_byp" value="to the register file and the bypass" style="text;html=1;fontSize=9;fontColor=#1f2937;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;rounded=1;owner=e-unit-pt;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1560.0" y="1045.5" width="223.9" height="18.5" as="geometry" />
        </mxCell>
