        <mxCell id="v-changed" value="&lt;b&gt;changed&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;fold spans VA 47:14, not 27:12&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;8 ways of 128 KiB&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;tag confirmed at 3 cycles&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;a wrong tag replays the load&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8f3;strokeColor=#dfb396;strokeWidth=1;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
