        <mxCell id="v-p_mmuc" value="&lt;b&gt;MMU cache&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;L2 to L4 entries&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafb;strokeColor=#bec4cc;strokeWidth=1;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="450" y="645" width="285" height="90" as="geometry" />
        </mxCell>
        <mxCell id="v-p_l2d" value="&lt;b&gt;L2 data cache&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;the rest&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafb;strokeColor=#bec4cc;strokeWidth=1;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
