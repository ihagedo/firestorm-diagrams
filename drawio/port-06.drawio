        <mxCell id="f-xlat-note" value="one dTLB lookup per cycle" style="text;html=1;fontSize=10;fontColor=#4b5563;align=right;verticalAlign=middle;spacing=0;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="2053.9" y="86" width="199.1" height="14" as="geometry" />
