        <mxCell id="v-l1i.cmp" value="=" style="triangle;slant=19.5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f2937;strokeWidth=1.1;fontSize=9;" vertex="1" parent="1">
