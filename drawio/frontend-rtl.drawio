  <diagram id="p2" name="S5 BTB">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2550" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
