        <mxCell id="title" value="S5  The branch target buffer: two tiers" style="text;html=1;kind=title;fontSize=18;fontStyle=1;fontColor=#1f2937;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="17" y="11" width="532" height="26" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="A fast tier of 1024 entries answers in the same cycle. A large tier coupled to the L1I answers after a bubble." style="text;html=1;kind=title;fontSize=11;fontColor=#4b5563;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="17" y="37" width="860" height="18" as="geometry" />
        </mxCell>
        <mxCell id="f-l0_tier" value="L0, same cycle" style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#f6f9fe;strokeColor=#95ade1;fontColor=#2563eb;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;container=0;" vertex="1" parent="1">
          <mxGeometry x="600.0" y="90.0" width="1860.0" height="375.0" as="geometry" />
        </mxCell>
        <mxCell id="f-l0_tier-note" value="no bubble when it hits" style="text;html=1;fontSize=10;fontColor=#4b5563;align=right;verticalAlign=middle;spacing=0;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="2287.3" y="96.0" width="165.7" height="14" as="geometry" />
        </mxCell>
        <mxCell id="f-l1_tier" value="L1, coupled to the L1I" style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#f6f9fe;strokeColor=#95ade1;fontColor=#2563eb;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;container=0;" vertex="1" parent="1">
          <mxGeometry x="600.0" y="510.0" width="1860.0" height="375.0" as="geometry" />
        </mxCell>
        <mxCell id="f-l1_tier-note" value="2 cycle bubble" style="text;html=1;fontSize=10;fontColor=#4b5563;align=right;verticalAlign=middle;spacing=0;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="2342.2" y="516.0" width="110.8" height="14" as="geometry" />
        </mxCell>
        <mxCell id="v-pc" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f7fe;strokeColor=#95ade1;strokeWidth=1;dashed=0;fontSize=10;fontColor=#1f2937;align=center;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
