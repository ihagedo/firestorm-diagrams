  <diagram id="p5" name="S8 fetch and I-cache">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2550" pageHeight="1260" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="S8  Fetch and the instruction cache: VIPT lookup to the instruction queue" style="text;html=1;kind=title;fontSize=18;fontStyle=1;fontColor=#1f2937;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="17" y="11" width="1015" height="26" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="The iTLB and the six-way L1I are read together from the virtual address. The physical tag confirms the way. Predecoded lines form fetch groups that queue for decode." style="text;html=1;kind=title;fontSize=11;fontColor=#4b5563;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="17" y="37" width="1332" height="18" as="geometry" />
        </mxCell>
        <mxCell id="f-tlbf" value="iTLB" style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#f6f9fe;strokeColor=#95ade1;fontColor=#2563eb;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;container=0;" vertex="1" parent="1">
          <mxGeometry x="60.0" y="240.0" width="630.0" height="390.0" as="geometry" />
        </mxCell>
        <mxCell id="f-tlbf-note" value="&lt;span style=&quot;background-color:#e0e9fc;border:1px solid #6692f1;border-radius:3px;padding:0 3px;font-weight:bold;color:#1f2937&quot;&gt;192 entries&lt;/span&gt;, &lt;span style=&quot;background-color:#eef3fd;border:1px dashed #6692f1;border-radius:3px;padding:0 3px;font-weight:bold;color:#1f2937&quot;&gt;4-way, 32 sets&lt;/span&gt;" style="text;html=1;fontSize=10;fontColor=#4b5563;align=right;verticalAlign=middle;spacing=0;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="460.4" y="246.0" width="222.6" height="14" as="geometry" />
        </mxCell>
        <mxCell id="f-l1if" value="L1I, 192 KiB, 6 ways" style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#faf7fe;strokeColor=#b39fe1;fontColor=#7c3aed;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;container=0;" vertex="1" parent="1">
          <mxGeometry x="750.0" y="240.0" width="1200.0" height="660.0" as="geometry" />
        </mxCell>
