        </mxCell>
        <mxCell id="subtitle" value="One fetch group per cycle. The next fetch predictor answers in one cycle; the slower predictors check it two cycles later; decode and execute check again." style="text;html=1;kind=title;fontSize=11;fontColor=#4b5563;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="17" y="37" width="1233" height="18" as="geometry" />
