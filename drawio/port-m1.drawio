        </mxCell>
        <mxCell id="v-nfp_entry-cell-6" value="mask 3:0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e9effd;strokeColor=#84a2e2;strokeWidth=0.6;fontSize=8;fontColor=#1f2937;connectable=0;" vertex="1" parent="v-nfp_entry">
          <mxGeometry x="918.8" y="0.0" width="61.2" height="30.0" as="geometry" />
        </mxCell>
        <mxCell id="v-nfp_training" value="&lt;b&gt;Training&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;written by the slow predictors on disagreement&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;kept until wrong twice&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;strong-set newcomers go to a FIFO overflow table&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b258c5;strokeWidth=1.3;dashed=1;dashPattern=1 2.5;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="820" width="470" height="93" as="geometry" />
        </mxCell>
        <mxCell id="v-phantom_fetch" value="&lt;b&gt;Phantom fetch, measured&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;a non-branch at a trained PC redirects fetch&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;the tag does not cover the whole PC&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;a hit is checked against the bytes at decode&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8d8fa;strokeColor=#2563eb;strokeWidth=1.4;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="560" y="820" width="480" height="93" as="geometry" />
        </mxCell>
        <mxCell id="v-l0_index" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f7fe;strokeColor=#95ade1;strokeWidth=1;dashed=0;fontSize=10;fontColor=#1f2937;align=center;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="1100" y="612" width="940" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v-l0_index-cell" value="ignored 47:11" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e9effd;strokeColor=#84a2e2;strokeWidth=0.6;fontSize=8;fontColor=#1f2937;connectable=0;" vertex="1" parent="v-l0_index">
          <mxGeometry x="0.0" y="0.0" width="724.6" height="30.0" as="geometry" />
        </mxCell>
        <mxCell id="v-l0_index-cell-2" value="set index 10:2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e9effd;strokeColor=#84a2e2;strokeWidth=0.6;fontSize=8;fontColor=#1f2937;connectable=0;" vertex="1" parent="v-l0_index">
          <mxGeometry x="724.6" y="0.0" width="176.2" height="30.0" as="geometry" />
        </mxCell>
        <mxCell id="v-l0_index-cell-3" value="0 1:0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e9effd;strokeColor=#84a2e2;strokeWidth=0.6;fontSize=8;fontColor=#1f2937;connectable=0;" vertex="1" parent="v-l0_index">
          <mxGeometry x="900.8" y="0.0" width="39.2" height="30.0" as="geometry" />
        </mxCell>
        <mxCell id="v-l0_reading" value="&lt;b&gt;Our reading&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;the L0 BTB is the fetch group table itself&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;2 way sets indexed by PC 10:2&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;branches 2 KiB apart share a set&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;test: three taken branches exactly 2 KiB apart&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6e1f9;strokeColor=#c026d3;strokeWidth=1.5;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="1100" y="790" width="560" height="111.25" as="geometry" />
        </mxCell>
        <mxCell id="v-one_taken" value="&lt;b&gt;One taken branch per cycle&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;measured in every case&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;no trace cache on the M1&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1c7f8;strokeColor=#2563eb;strokeWidth=2.2;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="1690" y="790" width="350" height="74.75" as="geometry" />
        </mxCell>
        <mxCell id="v-iq" value="&lt;b&gt;Instruction queue&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;depth open; a guess of at least 120&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;bypassed when empty&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;loop buffer source, no timing change&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;skipped short forward branch bodies deleted&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;strokeWidth=1;dashed=1;dashPattern=2 3;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="1040" width="520" height="111.25" as="geometry" />
        </mxCell>
        <mxCell id="v-decode" value="&lt;b&gt;Decode, 8 per cycle&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;NOP and B: no issue slot, one retire slot&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;shifted ALU op: one uop, issues twice&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;LDP: one uop, two register writes&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;pre- and post-index: an extra base uop&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;store: address uop and data uop&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;fusion pairs marked here, merged at map&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1c7f8;strokeColor=#2563eb;strokeWidth=2.2;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="610" y="1040" width="700" height="147.75" as="geometry" />
        </mxCell>
        <mxCell id="v-two_level_ras" value="&lt;b&gt;Return stack, two levels&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;50-entry main stack at decode&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;small fetch stack for early returns&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;a predicted return costs 1 bubble&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;overflow clears the stack; call cost jumps&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;PAC bits checked at push and pop&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b258c5;strokeWidth=1.3;dashed=1;dashPattern=1 2.5;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="1340" y="1040" width="700" height="129.5" as="geometry" />
        </mxCell>
