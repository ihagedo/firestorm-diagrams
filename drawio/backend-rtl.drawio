  <diagram id="p5" name="S14 retire window">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="990" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="S14 The retire window, 330 groups, the rename retire queue and the counters" style="text;html=1;kind=title;fontSize=18;fontStyle=1;fontColor=#1f2937;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="17" y="11" width="1062" height="26" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="The groups form a ring, drawn as a column that wraps, with the first and last five as slots. The rename retire queue sits beside it, then the commit pointer, the rates, the branch counter and the free-list return." style="text;html=1;kind=title;fontSize=11;fontColor=#4b5563;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="17" y="37" width="1654" height="18" as="geometry" />
        </mxCell>
        <mxCell id="f-fg" value="Retire groups" style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#f5fbf9;strokeColor=#8abfb3;fontColor=#059669;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;container=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="760" height="790" as="geometry" />
        </mxCell>
        <mxCell id="f-fg-note" value="&lt;span style=&quot;background-color:#c0e5da;border:1.4px solid #059669;border-radius:3px;padding:0 3px;font-weight:bold;color:#1f2937&quot;&gt;330 groups&lt;/span&gt;, &lt;span style=&quot;background-color:#ebf7f3;border:1px dashed #50b696;border-radius:3px;padding:0 3px;font-weight:bold;color:#1f2937&quot;&gt;up to 7 micro-ops&lt;/span&gt; each" style="text;html=1;fontSize=10;fontColor=#4b5563;align=right;verticalAlign=middle;spacing=0;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="506.1" y="76" width="286.9" height="14" as="geometry" />
        </mxCell>
        <mxCell id="f-fr" value="Rename retire queue" style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#f5fbf9;strokeColor=#8abfb3;fontColor=#059669;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;container=0;" vertex="1" parent="1">
          <mxGeometry x="840" y="70" width="640" height="790" as="geometry" />
        </mxCell>
        <mxCell id="f-fr-note" value="&lt;span style=&quot;background-color:#a5d9c9;border:1.4px solid #059669;border-radius:3px;padding:0 3px;font-weight:bold;color:#1f2937&quot;&gt;623 entries&lt;/span&gt;" style="text;html=1;fontSize=10;fontColor=#4b5563;align=right;verticalAlign=middle;spacing=0;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1373.6" y="76" width="99.4" height="14" as="geometry" />
        </mxCell>
        <mxCell id="f-fb" value="Counters" style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#f5fbf9;strokeColor=#8abfb3;fontColor=#059669;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;container=0;" vertex="1" parent="1">
          <mxGeometry x="1520" y="70" width="640" height="790" as="geometry" />
        </mxCell>
        <mxCell id="f-fb-note" value="limits that are their own window" style="text;html=1;fontSize=10;fontColor=#4b5563;align=right;verticalAlign=middle;spacing=0;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1911.1" y="76" width="241.9" height="14" as="geometry" />
        </mxCell>
        <mxCell id="v-commit" value="&lt;b&gt;Commit pointer&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;the oldest group&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;it retires when complete&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#c0e5da;strokeColor=#059669;strokeWidth=1.4;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="90" y="690" width="300" height="76" as="geometry" />
        </mxCell>
        <mxCell id="v-rate" value="&lt;b&gt;Retire rate&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;8 groups a cycle&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;16 queue entries a cycle&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#c0e5da;strokeColor=#059669;strokeWidth=1.4;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="420" y="690" width="340" height="76" as="geometry" />
        </mxCell>
        <mxCell id="v-free_return" value="&lt;b&gt;Free-list return&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;retire frees the old register&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;a flush frees the new one, from the tail&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#c0e5da;strokeColor=#059669;strokeWidth=1.4;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
