        <mxCell id="title" value="S10 Decode, eight decoders and what each one emits" style="text;html=1;kind=title;fontSize=18;fontStyle=1;fontColor=#1f2937;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="17" y="11" width="739" height="26" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Eight instructions come in a cycle. Each decoder emits one micro-op, a split pair or a fused pair, and the pair detector sits between neighbours. The player lights the decoder and the output it took." style="text;html=1;kind=title;fontSize=11;fontColor=#4b5563;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="17" y="37" width="1560" height="18" as="geometry" />
        </mxCell>
