        </mxCell>
        <mxCell id="subtitle" value="Drawn from the Passages room. A micro-op comes in and takes one exit: a wait, or a step on to the next room. Each exit is a state, and each pair of states has one arc." style="text;html=1;kind=title;fontSize=11;fontColor=#4b5563;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
