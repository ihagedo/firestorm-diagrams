          <mxGeometry x="283.3" y="0.0" width="33.3" height="30.0" as="geometry" />
        </mxCell>
        <mxCell id="v-line-cell-5" value="sector valid, 16 × 8 B 28:13" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef1e8;strokeColor=#e3a982;strokeWidth=0.6;fontSize=8;fontColor=#1f2937;connectable=0;" vertex="1" parent="v-line">
          <mxGeometry x="316.7" y="0.0" width="266.7" height="30.0" as="geometry" />
        </mxCell>
        <mxCell id="v-line-cell-6" value="byte mask 12:0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef1e8;strokeColor=#e3a982;strokeWidth=0.6;fontSize=8;fontColor=#1f2937;connectable=0;" vertex="1" parent="v-line">
          <mxGeometry x="583.3" y="0.0" width="216.7" height="30.0" as="geometry" />
        </mxCell>
        <mxCell id="v-slc_line_states" value="&lt;b&gt;Line states&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;invalid, valid, modified only&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;nothing above it is snooped through it&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;partial writes keep a byte mask&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9f6;strokeColor=#fb9d5c;strokeWidth=1;dashed=1;dashPattern=4 3;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="1140" y="400" width="390" height="104" as="geometry" />
        </mxCell>
        <mxCell id="v-slc_sticky_quota" value="&lt;b&gt;Groups and sticky lines&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;group id and a quota per client&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;replacement skips sticky lines&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;address ranges mapped as memory&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9f6;strokeColor=#fb9d5c;strokeWidth=1;dashed=1;dashPattern=4 3;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="1550" y="400" width="390" height="104" as="geometry" />
        </mxCell>
        <mxCell id="v-repl" value="&lt;b&gt;Replacement, disputed&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;pseudo random, EXAM&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;LRU for GPU placed lines, SLAC&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;insertion by client group reconciles&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#feebde;strokeColor=#fb9d5c;strokeWidth=1;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="1140" y="524" width="390" height="110" as="geometry" />
        </mxCell>
        <mxCell id="v-slc_slices" value="&lt;b&gt;Slices&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;two, even and odd lines, patent&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;or four planes, Asahi&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;each behind its own arbiter&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9f6;strokeColor=#fb9d5c;strokeWidth=1;dashed=1;dashPattern=4 3;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="1550" y="524" width="390" height="110" as="geometry" />
        </mxCell>
        <mxCell id="v-lat" value="&lt;b&gt;Latency, about 90 cycles&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;reported in passing, not pinned&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;split 17 + 20 + 30 + 20, ours&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;test, a 12 to 20 MiB chase&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbf2fc;strokeColor=#c026d3;strokeWidth=1.2;dashed=1;dashPattern=6 2;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="1140" y="654" width="390" height="118" as="geometry" />
        </mxCell>
        <mxCell id="v-slc_power_gating" value="&lt;b&gt;Power&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;ways power down to the share in use&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;idle SRAM at retention voltage&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;low QoS requests batched until awake&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9f6;strokeColor=#fb9d5c;strokeWidth=1;dashed=1;dashPattern=4 3;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="1550" y="654" width="390" height="118" as="geometry" />
        </mxCell>
        <mxCell id="v-slc_speculative_read" value="&lt;b&gt;Speculative DRAM read&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;enters the controller while the tags are checked&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;killed on a coherence or SLC hit&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9f6;strokeColor=#fb9d5c;strokeWidth=1;dashed=1;dashPattern=4 3;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="1140" y="792" width="800" height="80" as="geometry" />
        </mxCell>
        <mxCell id="v-issue0" value="&lt;b&gt;Associativity&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;16 ways, 4096 sets&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdcdab;strokeColor=#f97316;strokeWidth=2.2;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="950" width="610" height="56" as="geometry" />
        </mxCell>
        <mxCell id="v-issue1" value="&lt;b&gt;Indexing&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;all 12 index bits hashed from PA 32:7&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#feebde;strokeColor=#fb9d5c;strokeWidth=1;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="690" y="950" width="610" height="56" as="geometry" />
        </mxCell>
        <mxCell id="v-issue2" value="&lt;b&gt;Block size&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;128 B, sector valid and a byte mask&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#feebde;strokeColor=#fb9d5c;strokeWidth=1;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="1320" y="950" width="610" height="56" as="geometry" />
        </mxCell>
        <mxCell id="v-issue3" value="&lt;b&gt;Replacement&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;pseudo random vs LRU, disputed&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#feebde;strokeColor=#fb9d5c;strokeWidth=1;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="1014" width="610" height="56" as="geometry" />
        </mxCell>
        <mxCell id="v-issue4" value="&lt;b&gt;Write policy&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;write back, memory side, a write is done&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9f6;strokeColor=#fb9d5c;strokeWidth=1;dashed=1;dashPattern=4 3;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="690" y="1014" width="610" height="56" as="geometry" />
        </mxCell>
        <mxCell id="v-issue5" value="&lt;b&gt;Inclusion&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;exclusive, filled by L2 victims and GPU reads&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fedcc5;strokeColor=#f97316;strokeWidth=1.4;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="1320" y="1014" width="610" height="56" as="geometry" />
        </mxCell>
        <mxCell id="v-issue6" value="&lt;b&gt;Partitioning&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;group quotas, sticky lines, mapped ranges&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9f6;strokeColor=#fb9d5c;strokeWidth=1;dashed=1;dashPattern=4 3;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
