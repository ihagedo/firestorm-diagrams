        <mxCell id="v-pl2" value="&lt;b&gt;P-cluster L2&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;12 MiB, inclusive of the L1s&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdcdab;strokeColor=#f97316;strokeWidth=2.2;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="320" width="250" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v-el2" value="&lt;b&gt;E-cluster L2&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;its own L2&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#feebde;strokeColor=#fb9d5c;strokeWidth=1;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="355" y="320" width="250" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v-gpu" value="&lt;b&gt;GPU&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;reads allocate in the SLC&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fae1e1;strokeColor=#e66767;strokeWidth=1;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="630" y="320" width="250" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v-coherence_duplicate_tags" value="&lt;b&gt;Coherence point&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;duplicate L2 tags of every cluster&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;orders same address requests, MOESI&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef6f6;strokeColor=#e66767;strokeWidth=1;dashed=1;dashPattern=4 3;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="455" width="800" height="92" as="geometry" />
        </mxCell>
        <mxCell id="v-slc" value="&lt;b&gt;System level cache&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;memory side, a write that reaches it is written&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;filled by L2 victims, a CPU miss does not allocate&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;exclusive of the CPU caches&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fedcc5;strokeColor=#f97316;strokeWidth=1.4;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="600" width="800" height="112" as="geometry" />
        </mxCell>
        <mxCell id="v-mc" value="&lt;b&gt;Memory controllers, 8 channels, LPDDR4X&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;91 ns loaded, 68 GB/s peak, one core draws 64&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fae1e1;strokeColor=#e66767;strokeWidth=1;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="770" width="800" height="84" as="geometry" />
        </mxCell>
