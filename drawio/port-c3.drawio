        <mxCell id="title" value="System level cache, textbook form: 8 MiB, 16 ways, 4096 sets, memory side, every index bit hashed" style="text;html=1;kind=title;fontSize=18;fontStyle=1;fontColor=#1f2937;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="17" y="11" width="1396" height="26" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Not a CPU cache in the usual sense. It sits on the memory side of coherence, holds what the L2s evict, and is exclusive of them." style="text;html=1;kind=title;fontSize=11;fontColor=#4b5563;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="17" y="37" width="1036" height="18" as="geometry" />
        </mxCell>
        <mxCell id="f-fa" value="Physical address at the SLC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9f6;strokeColor=#dfb396;fontColor=#f97316;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;container=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1920" height="175" as="geometry" />
        </mxCell>
        <mxCell id="f-fa-note" value="every index bit is a hash" style="text;html=1;fontSize=10;fontColor=#4b5563;align=right;verticalAlign=middle;spacing=0;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1770.7" y="76" width="182.3" height="14" as="geometry" />
        </mxCell>
        <mxCell id="f-fb" value="Where it sits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef6f6;strokeColor=#d5989c;fontColor=#dc2626;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;container=0;" vertex="1" parent="1">
