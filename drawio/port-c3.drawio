        </mxCell>
        <mxCell id="f-fb-note" value="behind the coherence point, in front of the controllers" style="text;html=1;fontSize=10;fontColor=#4b5563;align=right;verticalAlign=middle;spacing=0;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="709.5" y="276" width="383.5" height="14" as="geometry" />
