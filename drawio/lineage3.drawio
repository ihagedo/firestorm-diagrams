        </mxCell>
        <mxCell id="v-kept" value="&lt;b&gt;kept&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;map history kept apart from retirement&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;retire in groups, not single uops&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;one entry for a fused pair&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2faf8;strokeColor=#8abfb3;strokeWidth=1;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="1070" y="200" width="280" height="93" as="geometry" />
        </mxCell>
        <mxCell id="v-changed" value="&lt;b&gt;changed&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;a map copy per instruction becomes&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;  a 623-entry queue of changes&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;8 checkpoints become 330 groups&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;a branch closes a group, not confidence&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2faf8;strokeColor=#8abfb3;strokeWidth=1;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="1070" y="309" width="280" height="129.5" as="geometry" />
